<?xml version="1.0"?>
<sdf version="1.9"><world name="kotoba_world">
<gui fullscreen="0"><plugin filename="MinimalScene" name="3D View"><gz-gui><title>3D View</title><property key="showTitleBar" type="bool">false</property><property key="state" type="string">docked</property></gz-gui><engine>ogre2</engine><scene>scene</scene><ambient_light>0.6 0.6 0.6</ambient_light><background_color>0.82 0.88 0.95</background_color><camera_pose>1.5 -1.5 0.95 0 0.42 2.18</camera_pose><camera_clip><near>0.03</near><far>100</far></camera_clip></plugin><plugin filename="GzSceneManager" name="Scene Manager"><gz-gui><property key="showTitleBar" type="bool">false</property><property key="state" type="string">floating</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="resizable" type="bool">false</property></gz-gui></plugin><plugin filename="InteractiveViewControl" name="Interactive view control"><gz-gui><property key="showTitleBar" type="bool">false</property><property key="state" type="string">floating</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="resizable" type="bool">false</property></gz-gui></plugin><plugin filename="WorldControl" name="World control"><gz-gui><property key="showTitleBar" type="bool">false</property><property key="resizable" type="bool">false</property><property key="width" type="double">121</property><property key="height" type="double">72</property><property key="z" type="double">1</property><property key="state" type="string">floating</property><anchors target="3D View"><line own="left" target="left" /><line own="bottom" target="bottom" /></anchors></gz-gui><play_pause>true</play_pause><step>true</step><start_paused>false</start_paused><service>/world/kotoba_world/control</service><stats_topic>/world/kotoba_world/stats</stats_topic></plugin><plugin filename="EntityTree" name="Entity tree" /></gui>
<physics name="physics" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1</real_time_factor></physics>
<plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
<plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
<plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
<gravity>0 0 -9.8</gravity>
<scene><ambient>0.6 0.6 0.6 1</ambient><background>0.82 0.88 0.95 1</background></scene>
<light type="directional" name="sun"><pose>0 0 8 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse><specular>0.2 0.2 0.2 1</specular><direction>-0.5 0.2 -1</direction><cast_shadows>false</cast_shadows></light>
<model name="floor"><static>true</static><link name="floor">
<collision name="collision"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
<visual name="visual"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry><material><ambient>0.55 0.6 0.65 1</ambient><diffuse>0.55 0.6 0.65 1</diffuse></material></visual>
</link></model>
<model name="kotoba_robot"><pose>0 0 0.01 0 0 0</pose>
<link name="base"><pose>0 0 0.17 0 0 0</pose><inertial><mass>2</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.002</izz></inertia></inertial><collision name="collision"><geometry><box><size>0.4 0.28 0.12</size></box></geometry><surface><friction><ode><mu>1</mu><mu2>1</mu2></ode></friction></surface></collision><visual name="visual"><geometry><box><size>0.4 0.28 0.12</size></box></geometry><material><ambient>0.12 0.55 0.85 1</ambient><diffuse>0.12 0.55 0.85 1</diffuse></material></visual></link><link name="left_wheel"><pose>0 0.18 0.1 1.57079632679 0 0</pose><inertial><mass>0.2</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.002</izz></inertia></inertial><collision name="collision"><geometry><cylinder><radius>0.1</radius><length>0.04</length></cylinder></geometry><surface><friction><ode><mu>1</mu><mu2>1</mu2></ode></friction></surface></collision><visual name="visual"><geometry><cylinder><radius>0.1</radius><length>0.04</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual></link><joint name="left_joint" type="revolute"><parent>base</parent><child>left_wheel</child><axis><xyz expressed_in="__model__">0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint><link name="right_wheel"><pose>0 -0.18 0.1 1.57079632679 0 0</pose><inertial><mass>0.2</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.002</izz></inertia></inertial><collision name="collision"><geometry><cylinder><radius>0.1</radius><length>0.04</length></cylinder></geometry><surface><friction><ode><mu>1</mu><mu2>1</mu2></ode></friction></surface></collision><visual name="visual"><geometry><cylinder><radius>0.1</radius><length>0.04</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual></link><joint name="right_joint" type="revolute"><parent>base</parent><child>right_wheel</child><axis><xyz expressed_in="__model__">0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint><link name="front_caster"><pose>0.16 0 0.045 0 0 0</pose><inertial><mass>0.05</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.002</izz></inertia></inertial><collision name="collision"><geometry><sphere><radius>0.045</radius></sphere></geometry><surface><friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction></surface></collision><visual name="visual"><geometry><sphere><radius>0.045</radius></sphere></geometry><material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual></link><joint name="front_fixed" type="fixed"><parent>base</parent><child>front_caster</child></joint><link name="rear_caster"><pose>-0.16 0 0.045 0 0 0</pose><inertial><mass>0.05</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.002</izz></inertia></inertial><collision name="collision"><geometry><sphere><radius>0.045</radius></sphere></geometry><surface><friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction></surface></collision><visual name="visual"><geometry><sphere><radius>0.045</radius></sphere></geometry><material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual></link><joint name="rear_fixed" type="fixed"><parent>base</parent><child>rear_caster</child></joint><link name="nose"><pose>0.205 0 0.18 0 0 0</pose><inertial><mass>0.01</mass><inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz></inertia></inertial><visual name="visual"><geometry><box><size>0.015 0.12 0.05</size></box></geometry><material><ambient>1 0.7 0.1 1</ambient><diffuse>1 0.7 0.1 1</diffuse></material></visual></link><joint name="nose_fixed" type="fixed"><parent>base</parent><child>nose</child></joint>
<plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
<left_joint>left_joint</left_joint><right_joint>right_joint</right_joint>
<wheel_separation>0.36</wheel_separation><wheel_radius>0.1</wheel_radius>
<topic>/kotoba/cmd_vel</topic><odom_topic>/kotoba/wheel_odom</odom_topic><tf_topic>/kotoba/wheel_tf</tf_topic>
<odom_publish_frequency>30</odom_publish_frequency>
<frame_id>wheel_odom</frame_id><child_frame_id>base</child_frame_id>
</plugin>
<!-- Feed back simulated body pose, not wheel-integrated odometry. -->
<plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
<odom_topic>/kotoba/odom</odom_topic>
<odom_frame>world</odom_frame><robot_base_frame>kotoba_robot</robot_base_frame>
<odom_publish_frequency>30</odom_publish_frequency><dimensions>2</dimensions>
<tf_topic>/kotoba/body_tf</tf_topic>
</plugin>
</model></world></sdf>

